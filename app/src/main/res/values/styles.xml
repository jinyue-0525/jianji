<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppLaunchTheme" parent="@style/AppTheme" />
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#3B52C7</item>
        <item name="android:colorControlNormal">#1E2433</item>
        <item name="android:colorControlActivated">#4D6BFE</item>
        <item name="android:colorControlHighlight">#184D6BFE</item>
        <item name="android:textColorPrimary">#1E2433</item>
        <item name="android:textColorSecondary">#697386</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#3B52C7</item>
        <item name="android:colorControlActivated">#4D6BFE</item>
        <item name="android:textColorPrimary">#1E2433</item>
        <item name="android:textColorSecondary">#697386</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
